# --- Serveur ---------------------------------------------------------------
PORT=3000
PUBLIC_URL=https://ton-domaine.com        # URL publique (retours et webhooks de paiement)
DATA_FILE=data/db.json

# --- Identité du vendeur (affichée sur les reçus) ---------------------------
MERCHANT_NAME="Terra Vida"
MERCHANT_ADDRESS="Cotonou, Bénin"
MERCHANT_TAX_ID="IFU 0000000000000"
MERCHANT_SUPPORT="support@ton-domaine.com"
MERCHANT_TERMS_URL=https://ton-domaine.com/cgv
MERCHANT_TZ=Africa/Porto-Novo

# --- Paiements (un prestataire s'active dès que ses clés sont présentes) ----
# FedaPay : MTN MoMo, Moov Money, Celtiis Cash (Bénin…)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox                      # sandbox | live
# Wave Checkout (Sénégal, Côte d'Ivoire…)
WAVE_API_KEY=
# CinetPay : Orange Money, MTN, Moov, Wave (multi-pays)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# PayPal : compte PayPal et cartes bancaires
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox                       # sandbox | live

# Développement uniquement : caisse simulée (refusée si NODE_ENV=production)
PAYMENTS_SANDBOX=0

# --- Connexion par SMS (code à 6 chiffres) -----------------------------------
# Africa's Talking (prioritaire s'il est configuré). AT_USERNAME=sandbox pour tester.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=                            # nom d'expéditeur validé (ex. TERRAVIDA)
# Twilio (repli)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                             # numéro ou nom d'expéditeur
TWILIO_MESSAGING_SERVICE_SID=
SMS_PROVIDER=                            # forcer : africastalking | twilio
# Développement : le code s'affiche dans la console et dans le jeu (refusé en production)
SMS_DEV=0
# Derrière un proxy (Nginx, Render…) : lire l'IP réelle dans X-Forwarded-For
TRUST_PROXY=0

# --- Administration -----------------------------------------------------------
# Numéros (vérifiés par SMS) qui ont accès à l'écran 🛡️ Modération, séparés par des virgules
ADMIN_PHONES=+2290100000000
